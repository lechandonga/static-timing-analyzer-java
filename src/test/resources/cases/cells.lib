unit ns
cell INV comb
  pin A comb
  pin Y comb
  delay A Y 0.05
endcell
cell BUF comb
  pin A comb
  pin Y comb
  delay A Y 0.30
endcell
cell SLOW comb
  pin A comb
  pin Y comb
  delay A Y 0.80
endcell
cell AND2 comb
  pin A comb
  pin B comb
  pin Y comb
  delay A Y 0.10
  delay B Y 0.12
endcell
cell DFF seq
  pin D seq_in
  pin CK clk
  pin Q seq_out
  timing setup=0.05 hold=0.02 clk_to_q=0.08
endcell
cell DFFH seq
  pin D seq_in
  pin CK clk
  pin Q seq_out
  timing setup=0.05 hold=0.50 clk_to_q=0.02
endcell
